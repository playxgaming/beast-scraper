# Server
HOST=127.0.0.1
PORT=8000
# Leave empty to disable auth in local-only mode; set a secret string to require ?api_key=... or X-API-Key header
API_KEY=
# Separate header-only key for admin routes. Admin is disabled when both keys are empty.
ADMIN_API_KEY=
# Enable restrictions on per-request proxies and optional adapters for internet deployments.
PUBLIC_MODE=false
API_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=2
WEB_MAX_MB=5
# Set false on hosts with very little memory. HTTP scraping, search and PDFs still work.
BROWSER_ENABLED=true
# Optional free OpenAlex key; arXiv and Semantic Scholar do not require it.
OPENALEX_API_KEY=
# Opt in to the heavier [pdf] layout parser; basic extraction works without it.
PDF_LAYOUT_ENABLED=false

# Cache & Rate Limiting
CACHE_DB_PATH=data/cache.db
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_DOMAIN_RPM=30

# Browser / Web Engine
PLAYWRIGHT_HEADLESS=true
REQUEST_TIMEOUT_SECONDS=30
MAX_CRAWL_PAGES=25
PDF_MAX_MB=30

# Optional local SearXNG instance (e.g. http://localhost:8888 when running docker-compose)
SEARXNG_URL=

# Optional Proxy Pool (comma-separated URLs or country-tagged entries)
# Examples:
#   PROXIES=http://user:pass@proxy1.example.com:8000,socks5://user:pass@proxy2.example.com:1080
#   PROXIES=us|http://user:pass@us.proxy.com:8000,in|http://user:pass@in.proxy.com:8000
PROXIES=
# Optional rotating proxy template supporting {country} and {session} placeholders
# Example: http://user-country-{country}-session-{session}:pass@gate.provider.com:7777
PROXY_TEMPLATE=
# Optional path to a newline-delimited proxy file (one proxy URL or `country|url` per line)
PROXY_FILE=
PROXIES_PREMIUM_ONLY=false

# Security: block localhost/private-network targets by default to prevent SSRF
ALLOW_PRIVATE_URLS=false
